# DISPATCH 44 — Risk & Survival layer: LOCAL-ONLY privacy files, never mirrored.
# Real equity, real open positions, and the live trade journal stay on the Mac.
*.local.json
real_equity.local.json
journal.local.json
positions.local.json
loss_limits_config.local.json

# Local rollback backups (Dispatch backups) — never published
.backups/

# python bytecode
__pycache__/
*.pyc

# Secrets — NEVER commit to this public repo. Real values live only on the Mac
# (~/.arsenal_env, chmod 600). These patterns are a safety net against accidental adds.
*.env
.env
.env.*
*.pem
*.key
*.p12
*.plist
*_env
arsenal_env
*secret*
*credential*
*app_pass*
